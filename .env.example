NODE_ENV=dev
PORT=3001
# How long the readiness probe fails before the server closes on SIGTERM.
SHUTDOWN_DRAIN_DELAY_MS=10000

# Database — TypeORM connects with these, and `docker-compose.yaml` provisions
# the Postgres container from the same values.
DB_HOST=localhost
DB_PORT=5437
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=products_db

# Test infrastructure (docker compose `test` profile) — a throwaway Postgres
# the int/e2e lanes connect to, kept apart from the dev one on 5437.
DB_TEST_PORT=5438
DB_TEST_USERNAME=test
DB_TEST_PASSWORD=test
DB_TEST_DATABASE=products_db_test

# Observability (@viniciusferreira7/signals)
# These are read by the `--require @viniciusferreira7/signals/register` preload,
# which runs BEFORE Nest's ConfigModule loads this file. Exporting them in the
# real process environment is therefore required; the entries here document the
# expected values and feed the non-preload fallback path.
OTEL_SERVICE_NAME=products-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LOG_LEVEL=debug

# JWT
# Must be the SAME value configured in users-service (which signs the tokens)
# and the api-gateway. At least 32 characters; generate one with
# `openssl rand -hex 32`. Left empty on purpose: the service refuses to boot
# until a real secret is set.
JWT_SECRET=
